# Builds the jar from the sources, then runs it. Gradle downloads Node.js for the frontend itself;
# it is built for glibc, so the builder must not be an Alpine (musl) image.
# Also a build environment for CI agents that can't run the frontend tools (e.g. an old Alpine):
#   docker build --target builder --build-arg GRADLE_TASKS="clean build" -f docker/Dockerfile.build .
FROM eclipse-temurin:17-jdk AS builder
ARG GRADLE_TASKS="clean assemble"
WORKDIR /app
COPY . .
# a Windows checkout may have CRLF line endings
RUN sed -i 's/\r$//' gradlew && sh ./gradlew $GRADLE_TASKS --no-daemon

FROM amazoncorretto:17

USER 1000
WORKDIR /app

COPY --from=builder /app/build/libs/databucket-server-*.jar app.jar
EXPOSE 8080

CMD ["java", "-jar", "app.jar"]
