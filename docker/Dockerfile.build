# Builds the jar from the sources (Node for the Vite frontend, JDK for the backend), then runs it.
FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache openjdk17
COPY . .
# a Windows checkout may have CRLF line endings
RUN sed -i 's/\r$//' gradlew && sh ./gradlew clean assemble --no-daemon

FROM amazoncorretto:17

USER 1000
WORKDIR /app

COPY --from=builder /app/build/libs/databucket-server-*.jar app.jar
EXPOSE 8080

CMD ["java", "-jar", "app.jar"]
