<?xml version="1.0" encoding="UTF-8"?>
<!-- Named log4j2-spring.xml so Spring Boot loads it and the SpringProfile arbiter works. Levels live in application.yaml. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT" follow="true">
            <Select>
                <!-- Local runs and tests: readable colored text. requestId, user and project come from the MDC. -->
                <SpringProfile name="default | test | testing">
                    <PatternLayout pattern="%style{%d{ISO8601}}{bright,black} %highlight{%-5level }[%style{%t}{bright,blue}] %style{%c{1.}}{bright,yellow}%style{%notEmpty{ req=%X{requestId}}%notEmpty{ user=%X{user}}%notEmpty{ project=%X{project}}}{cyan}: %msg%n%throwable"/>
                </SpringProfile>
                <!-- Servers: one JSON object per line, MDC entries included as fields -->
                <DefaultArbiter>
                    <StructuredLogLayout format="logstash" charset="UTF-8"/>
                </DefaultArbiter>
            </Select>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
